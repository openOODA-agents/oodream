// # ootheme Unified Palette & Token Engine
//
// Logline: Provide canonical RGBA32 GUI and ANSI SGR TUI semantic color palettes and box-drawing tokens for all openOODA services.
//
// Setup: Pure deterministic theme resolver sealed with oo_pqc_sha3_round; supports ooda-dark, ooda-light, 1982, high-contrast, and no-color.
//
// Beats:
//   1. Resolve a named theme into an OoThemePalette with 32-bit RGBA GUI integers and ANSI SGR strings.
//   2. Seal the palette checksum with oo_pqc_sha3_round and verify fail-closed integrity.
//   3. Render deterministic TUI dashboard frames and JSON theme descriptors for any service.

import "oostd/sec/pqc.oo";
import "oostd/core/primitives/str.oo";
import "oostd/core/primitives/str_extra.oo";

type OoThemePalette = struct {
    name: String,
    bg_rgba: Int,
    surface_rgba: Int,
    fg_rgba: Int,
    accent_rgba: Int,
    ok_rgba: Int,
    warn_rgba: Int,
    err_rgba: Int,
    ansi_hdr: String,
    ansi_ok: String,
    ansi_rst: String,
    border_tl: String,
    border_tr: String,
    border_bl: String,
    border_br: String,
    border_h: String,
    border_v: String,
    checksum: Int
};

pub fn ootheme_checksum(bg: Int, surf: Int, fg: Int, acc: Int, okc: Int, wrn: Int, errc: Int) -> Int {
    let mut c: Int = oo_pqc_sha3_round(bg, surf);
    c = oo_pqc_sha3_round(c, fg);
    c = oo_pqc_sha3_round(c, acc);
    c = oo_pqc_sha3_round(c, okc);
    c = oo_pqc_sha3_round(c, wrn);
    return oo_pqc_sha3_round(c, errc);
}

fn ootheme_rgb(s: String) -> Int {
    let parts: List[String] = str_split(s, ";");
    if list_len(parts) != 3 { return 0; }
    let r: Int = parse_int_digits(list_get(parts, 0));
    let g: Int = parse_int_digits(list_get(parts, 1));
    let b: Int = parse_int_digits(list_get(parts, 2));
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn ootheme_toned(name: String, acc: String, ok: String, wrn: String, err: String) -> OoThemePalette {
    let bg: Int = 185276159;
    let surf: Int = 303178751;
    let fg: Int = 3873892351;
    let ari: Int = ootheme_rgb(acc);
    let oki: Int = ootheme_rgb(ok);
    let wri: Int = ootheme_rgb(wrn);
    let eri: Int = ootheme_rgb(err);
    let cs: Int = ootheme_checksum(bg, surf, fg, ari, oki, wri, eri);
    return OoThemePalette {
        name: name, bg_rgba: bg, surface_rgba: surf, fg_rgba: fg,
        accent_rgba: ari, ok_rgba: oki, warn_rgba: wri, err_rgba: eri,
        ansi_hdr: chr(27) + "[1;38;2;" + acc + "m",
        ansi_ok: chr(27) + "[1;38;2;" + ok + "m",
        ansi_rst: chr(27) + "[0m",
        border_tl: "+", border_tr: "+", border_bl: "+", border_br: "+",
        border_h: "-", border_v: "|",
        checksum: cs
    };
}

pub fn ootheme_known(name: String) -> Bool {
    if name == "ooda-dark" || name == "oote-dark" { return true; }
    if name == "ooda-light" || name == "1982" { return true; }
    if name == "minimax" || name == "nord" || name == "dracula" || name == "cyberpunk" ||
        name == "plain" || name == "frost" || name == "amethyst" || name == "thaw" ||
        name == "bloom" || name == "meadow" || name == "solstice" || name == "mirage" ||
        name == "amber" || name == "equinox" || name == "ember" || name == "hearth" ||
        name == "solitude" || name == "nova" || name == "lantern" || name == "sakura" ||
        name == "sol" || name == "spooky" || name == "harvest" || name == "yule" { return true; }
    if name == "high-contrast" || name == "no-color" { return true; }
    return false;
}

pub fn ootheme_resolve(name: String) -> OoThemePalette {
    if name == "ooda-light" {
        let cs: Int = ootheme_checksum(4143380479, 3974691071, 286331391, 459007, 16810495, 3600384255, 3692212991);
        return OoThemePalette { name: "ooda-light", bg_rgba: 4143380479, surface_rgba: 3974691071, fg_rgba: 286331391,
            accent_rgba: 459007, ok_rgba: 16810495, warn_rgba: 3600384255, err_rgba: 3692212991, ansi_hdr: chr(27) + "[1;34m",
            ansi_ok: chr(27) + "[1;32m", ansi_rst: chr(27) + "[0m",
            border_tl: "+", border_tr: "+", border_bl: "+", border_br: "+",
            border_h: "-", border_v: "|", checksum: cs };
    }
    if name == "1982" {
        let cs: Int = ootheme_checksum(168430335, 336860415, 872349951, 4289331455, 872349951, 4289331455, 4282664191);
        return OoThemePalette { name: "1982", bg_rgba: 168430335, surface_rgba: 336860415, fg_rgba: 872349951,
            accent_rgba: 4289331455, ok_rgba: 872349951, warn_rgba: 4289331455,
            err_rgba: 4282664191, ansi_hdr: chr(27) + "[1;33m",
            ansi_ok: chr(27) + "[1;32m", ansi_rst: chr(27) + "[0m",
            border_tl: "+", border_tr: "+", border_bl: "+", border_br: "+",
            border_h: "=", border_v: "|", checksum: cs };
    }
    if name == "minimax" { return ootheme_toned(name, "224;160;64", "122;200;136", "224;160;64", "224;112;96"); }
    if name == "nord" { return ootheme_toned(name, "136;192;208", "163;190;140", "235;203;139", "191;97;106"); }
    if name == "dracula" { return ootheme_toned(name, "189;147;249", "80;250;123", "241;250;140", "255;85;85"); }
    if name == "cyberpunk" { return ootheme_toned(name, "0;255;255", "0;255;102", "255;230;0", "255;0;85"); }
    if name == "ember" { return ootheme_toned(name, "251;146;60", "74;222;128", "251;191;36", "248;113;113"); }
    if name == "hearth" { return ootheme_toned(name, "224;122;95", "129;178;154", "242;204;143", "239;68;68"); }
    if name == "frost" || name == "solitude" || name == "mirage" || name == "thaw" {
        return ootheme_toned(name, "114;215;246", "78;216;163", "252;211;77", "248;113;113");
    }
    if name == "bloom" || name == "sakura" || name == "amethyst" {
        return ootheme_toned(name, "244;114;182", "134;239;172", "253;224;71", "251;113;133");
    }
    if name == "meadow" || name == "yule" {
        return ootheme_toned(name, "74;222;128", "52;211;153", "250;204;21", "239;68;68");
    }
    if name == "amber" || name == "harvest" || name == "sol" || name == "solstice" ||
        name == "equinox" || name == "nova" || name == "spooky" || name == "lantern" {
        return ootheme_toned(name, "245;158;11", "74;222;128", "251;191;36", "239;68;68");
    }
    if name == "high-contrast" || name == "no-color" || name == "plain" {
        let cs: Int = ootheme_checksum(255, (1 << 8) - 1, ((1 << 32) - 1), 4294902015, 16711935, 4294902015, 4278190335);
        return OoThemePalette { name: name, bg_rgba: 255, surface_rgba: 255, fg_rgba: ((1 << 32) - 1), accent_rgba: 4294902015,
            ok_rgba: 16711935, warn_rgba: 4294902015, err_rgba: 4278190335, ansi_hdr: "", ansi_ok: "", ansi_rst: "",
            border_tl: "+", border_tr: "+", border_bl: "+", border_br: "+", border_h: "-", border_v: "|", checksum: cs };
    }
    let cs: Int = ootheme_checksum(185276159, 303178751, 3873892351, 1490814975, 1069054463, 4071192063, 4166138879);
    return OoThemePalette { name: "ooda-dark", bg_rgba: 185276159, surface_rgba: 303178751, fg_rgba: 3873892351,
        accent_rgba: 1490814975, ok_rgba: 1069054463, warn_rgba: 4071192063, err_rgba: 4166138879, ansi_hdr: chr(27) + "[1;36m",
        ansi_ok: chr(27) + "[1;32m", ansi_rst: chr(27) + "[0m", border_tl: "+", border_tr: "+", border_bl: "+", border_br: "+",
        border_h: "-", border_v: "|", checksum: cs };
}

pub fn ootheme_verify(p: OoThemePalette) -> Bool {
    if ootheme_known(p.name) == false { return false; }
    let want: Int = ootheme_checksum(p.bg_rgba, p.surface_rgba, p.fg_rgba, p.accent_rgba, p.ok_rgba, p.warn_rgba, p.err_rgba);
    return p.checksum == want && p.checksum > 0;
}

pub fn ootheme_tui_frame(p: OoThemePalette, comp: String, ver: String, layer: String, status: String) -> String {
    let w: Int = 58;
    let bar: String = str_repeat("-", w);
    let top: String = p.border_tl + bar + p.border_tr + "\n";
    let hv: String = " " + comp + " " + ver + " [" + layer + "] theme=" + p.name;
    let hp: Int = if chars_len(hv) < w { w - chars_len(hv) } else { 1 };
    let hdr: String = p.border_v + " " + p.ansi_hdr + comp + " " + ver + p.ansi_rst +
        " [" + layer + "] theme=" + p.name + str_repeat(" ", hp) + p.border_v + "\n";
    let mv: String = " status: " + status + " | bg=" + p.bg_rgba.to_string() + " fg=" + p.fg_rgba.to_string();
    let mp: Int = if chars_len(mv) < w { w - chars_len(mv) } else { 1 };
    let mid: String = p.border_v + " status: " + p.ansi_ok + status + p.ansi_rst + " | bg=" +
        p.bg_rgba.to_string() + " fg=" + p.fg_rgba.to_string() + str_repeat(" ", mp) + p.border_v + "\n";
    let bot: String = p.border_bl + bar + p.border_br;
    return top + hdr + mid + bot;
}

pub fn ootheme_json(p: OoThemePalette) -> String {
    return "{\"theme\":\"" + p.name + "\",\"bg_rgba\":" + p.bg_rgba.to_string() + ",\"fg_rgba\":" + p.fg_rgba.to_string() +
        ",\"accent_rgba\":" + p.accent_rgba.to_string() + ",\"checksum\":" + p.checksum.to_string() + "}";
}
