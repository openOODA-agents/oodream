// # oodream Path Guard - CWE-22 Traversal Rejection
//
// Logline: Admits or refuses every filesystem path operand before it reaches a capability call.
//
// Setup: Imports the shared oostd traversal invariant; pure string checks, no capability, no I/O.
//
// Beats:
//   1. oodrm_path_ok refuses an empty path.
//   2. oodrm_path_ok refuses a path carrying a parent-directory segment (CWE-22).
//   3. oodrm_path_ok refuses a path carrying a control character (CWE-367).

import "oostd/fs/file/fs_grp/fs_invariants.oo";

fn oodrm_path_ctl(path: String) -> Bool {
    let mut i: Int = 0;
    while i < bytes_len(path) {
        let c: Int = byte_at(path, i);
        if c < 32 || c == 127 { return true; }
        i = i + 1;
    }
    return false;
}

pub fn oodrm_path_ok(path: String) -> Bool {
    if bytes_len(path) == 0 { return false; }
    if fs_is_dotdot_traversal(path) == 1 { return false; }
    if oodrm_path_ctl(path) { return false; }
    return true;
}

pub fn oodrm_arg_ok(arg: String) -> Bool {
    if fs_is_dotdot_traversal(arg) == 1 { return false; }
    if oodrm_path_ctl(arg) { return false; }
    return true;
}
