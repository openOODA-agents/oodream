// # oodream Byzantine Quorum Verifier
//
// Logline: Requires a 2f+1 quorum of independent hat badges and PQC seals before Act commits.
//
// Setup: Declared capability: None. Pure verification over attestation votes and badges.
//
// Beats:
//   1. Derive the 2f+1 quorum size from the declared member count.
//   2. Mint one vote per hat, and let every vote carry the badge of its own hat.
//   3. Count the votes with the standard counter, which refuses a repeated badge.
//   4. Verify every ML-DSA-65 vote signature under mask == 7.

import "attest.oo";
import "oostd/sec/quorum_grp/quorum.oo";
import "oostd/sec/pqc.oo";

pub fn oodrm_qfmac(fmac: Int, phash: Int) -> Int {
    return oo_quorum_seal(fmac, 193, phash,
        oo_pqc_sha3_round(fmac, 1609587929392839161),
        oo_pqc_sha3_round(phash, 4132994306676758123));
}

// The registers of the votes. The badge of every vote is read from its own
// register, so the standard counter can tell the hats apart.
pub fn oodrm_quorum_regs(votes: List[OodrmAttest]) -> List[Int] {
    let mut regs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(votes) {
        regs = list_push(regs, list_get(votes, i).reg);
        i = i + 1;
    }
    return regs;
}

// The badges of the hats that vote in a quorum. Every hat carries its own
// scope badge, so three hats hold three badges that no counter can fold.
pub fn oodrm_quorum_badges() -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 11);
    b = list_push(b, 12);
    b = list_push(b, 13);
    return b;
}

// The register of one hat: the register of the caller with the badge of the
// hat in place of the badge of the caller. The epoch, the rights and the
// capabilities of the register are the same for every hat.
pub fn oodrm_quorum_vote_reg(reg: Int, badge: Int) -> Int {
    return reg - (oo_quorum_badge(reg) << 32) + (badge << 32);
}

// The three votes of a quorum. Every vote is sealed by its own key and carries
// the badge of its own hat, so the three votes hold three distinct badges.
pub fn oodrm_quorum_votes(signer: String, reg: Int, qm: Int) -> List[OodrmAttest] {
    let mut v: List[OodrmAttest] = list_new();
    let hats: List[Int] = oodrm_quorum_badges();
    let mut i: Int = 0;
    while i < list_len(hats) {
        v = list_push(v, oodrm_attest_seal(oodrm_attest_keypair(
            oodrm_attest_seed(signer + "-q" + i.to_string())), signer,
            oodrm_quorum_vote_reg(reg, list_get(hats, i)), qm));
        i = i + 1;
    }
    return v;
}

pub fn oodrm_sigs_distinct(votes: List[OodrmAttest]) -> Bool {
    let n: Int = list_len(votes);
    let mut i: Int = 0;
    while i < n {
        let vi: OodrmAttest = list_get(votes, i);
        let mut j: Int = i + 1;
        while j < n {
            let vj: OodrmAttest = list_get(votes, j);
            if vi.sig == vj.sig { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

// The verification of a quorum. The badges are not taken from the caller: they
// are read from the register of every vote, and the standard counter refuses a
// quorum whose hats do not hold distinct badges.
pub fn oodrm_quorum_verify(votes: List[OodrmAttest], reg: Int,
                    fmac: Int, phash: Int, members: Int) -> Int {
    let mut bits: Int = 0;
    let qm: Int = oodrm_qfmac(fmac, phash);
    let cnt: Int = list_len(votes);
    let hats: List[Int] = oodrm_quorum_badges();
    let mut struct_ok: Bool = cnt == list_len(hats) && cnt >= 3 &&
        oodrm_sigs_distinct(votes);
    let mut seals_ok: Bool = true;
    let mut i: Int = 0;
    while i < cnt {
        let v: OodrmAttest = list_get(votes, i);
        let badge: Int = oo_quorum_badge(v.reg);
        let mut is_hat: Bool = false;
        let mut h: Int = 0;
        while h < list_len(hats) {
            if list_get(hats, h) == badge { is_hat = true;
            }
            h = h + 1;
        }
        if v.magic != 8365001 || v.fmac != qm || !is_hat ||
            oodrm_quorum_vote_reg(v.reg, oo_quorum_badge(reg)) != reg ||
            ((v.reg >> 48) & 65535) != ((reg >> 48) & 65535) ||
            chars_len(v.sig) != 6618 { struct_ok = false; }
        if crypto_mldsa65_verify_internal(v.pk, oodrm_attest_msg(v.reg, qm),
            v.sig) != "OK" { seals_ok = false; }
        i = i + 1;
    }
    let counted: Int = oo_quorum_count(oodrm_quorum_regs(votes), (members - 1) / 3);
    let need: Int = oo_quorum_threshold((members - 1) / 3);
    if struct_ok { bits = bits | 1; }
    if counted == cnt && counted >= need && cnt <= members { bits = bits | 2; }
    if seals_ok { bits = bits | 4; }
    return bits;
}

pub fn oodrm_quorum_ok(votes: List[OodrmAttest], reg: Int,
                fmac: Int, phash: Int, members: Int) -> Bool {
    return oodrm_quorum_verify(votes, reg, fmac, phash, members) == 7;
}
